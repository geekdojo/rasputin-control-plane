[
  {
    "alias": "rasputin-signin-administering-authenticate",
    "requirement": "REQUIRED",
    "children": [
      {
        "alias": "rasputin-signin-administering-sign-in",
        "requirement": "REQUIRED",
        "children": [
          {
            "provider": "auth-username-password-form",
            "requirement": "REQUIRED"
          },
          {
            "alias": "rasputin-signin-administering-second-step-webauthn",
            "requirement": "CONDITIONAL",
            "children": [
              {
                "provider": "conditional-credential",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-webauthn-no-passkey",
                "config": {
                  "credentials": "webauthn-passwordless",
                  "included": "false"
                }
              },
              {
                "provider": "conditional-user-attribute",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-webauthn-marker",
                "config": {
                  "attribute_expected_value": "true",
                  "attribute_name": "rasputin_second_step_any",
                  "include_group_attributes": "false",
                  "not": "false",
                  "regex": "false"
                }
              },
              {
                "provider": "conditional-user-attribute",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-webauthn-door",
                "config": {
                  "attribute_expected_value": "true",
                  "attribute_name": "rasputin_webauthn_app",
                  "include_group_attributes": "false",
                  "not": "false",
                  "regex": "false"
                }
              },
              {
                "provider": "webauthn-authenticator-passwordless",
                "requirement": "ALTERNATIVE"
              },
              {
                "provider": "webauthn-authenticator",
                "requirement": "ALTERNATIVE"
              },
              {
                "provider": "auth-otp-form",
                "requirement": "ALTERNATIVE"
              },
              {
                "provider": "auth-recovery-authn-code-form",
                "requirement": "ALTERNATIVE"
              }
            ]
          },
          {
            "alias": "rasputin-signin-administering-second-step-codes",
            "requirement": "CONDITIONAL",
            "children": [
              {
                "provider": "conditional-credential",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-codes-no-passkey",
                "config": {
                  "credentials": "webauthn-passwordless",
                  "included": "false"
                }
              },
              {
                "provider": "conditional-user-attribute",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-codes-marker",
                "config": {
                  "attribute_expected_value": "true",
                  "attribute_name": "rasputin_second_step_any",
                  "include_group_attributes": "false",
                  "not": "false",
                  "regex": "false"
                }
              },
              {
                "provider": "conditional-user-attribute",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-second-step-codes-door",
                "config": {
                  "attribute_expected_value": "true",
                  "attribute_name": "rasputin_webauthn_app",
                  "include_group_attributes": "false",
                  "not": "true",
                  "regex": "false"
                }
              },
              {
                "provider": "conditional-user-configured",
                "requirement": "REQUIRED"
              },
              {
                "provider": "auth-otp-form",
                "requirement": "ALTERNATIVE"
              },
              {
                "provider": "auth-recovery-authn-code-form",
                "requirement": "ALTERNATIVE"
              }
            ]
          },
          {
            "alias": "rasputin-signin-administering-every-account",
            "requirement": "CONDITIONAL",
            "children": [
              {
                "provider": "conditional-credential",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-every-account-no-passkey",
                "config": {
                  "credentials": "webauthn-passwordless",
                  "included": "false"
                }
              },
              {
                "provider": "conditional-sub-flow-executed",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-every-account-no-webauthn-step",
                "config": {
                  "check_result": "not-executed",
                  "flow_to_check": "rasputin-signin-administering-second-step-webauthn"
                }
              },
              {
                "provider": "conditional-sub-flow-executed",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-every-account-no-codes-step",
                "config": {
                  "check_result": "not-executed",
                  "flow_to_check": "rasputin-signin-administering-second-step-codes"
                }
              },
              {
                "provider": "deny-access-authenticator",
                "requirement": "REQUIRED",
                "configAlias": "rasputin-signin-administering-every-account-deny",
                "config": {
                  "denyErrorMessage": "Signing in to this app needs a second step. Add a passkey, security key or authenticator app in Your account, then try again."
                }
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "alias": "rasputin-signin-administering-access-gate",
    "requirement": "CONDITIONAL",
    "children": [
      {
        "provider": "conditional-user-attribute",
        "requirement": "REQUIRED",
        "configAlias": "rasputin-signin-administering-access-gate-attribute",
        "config": {
          "attribute_expected_value": "^(user|admin)$",
          "attribute_name": "rasputin_app_role",
          "include_group_attributes": "false",
          "not": "true",
          "regex": "true"
        }
      },
      {
        "provider": "deny-access-authenticator",
        "requirement": "REQUIRED",
        "configAlias": "rasputin-signin-administering-access-gate-deny",
        "config": {
          "denyErrorMessage": "Your account doesn't have access to apps yet. Ask an administrator."
        }
      }
    ]
  }
]
