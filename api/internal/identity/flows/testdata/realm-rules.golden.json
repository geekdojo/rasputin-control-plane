{
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 1800,
  "accessTokenLifespan": 300,
  "browserFlow": "rasputin-signin-app-clients",
  "bruteForceProtected": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "failureFactor": 100,
  "internationalizationEnabled": false,
  "loginWithEmailAllowed": true,
  "maxDeltaTimeSeconds": 43200,
  "maxSecondaryAuthFailures": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "otpPolicyPeriod": 30,
  "passwordPolicy": "length(15) and maxLength(128) and notUsername(undefined) and notEmail(undefined) and passwordBlacklist(rasputin-common-passwords.txt)",
  "permanentLockout": false,
  "quickLoginCheckMilliSeconds": 0,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "resetCredentialsFlow": "rasputin-reset",
  "resetPasswordAllowed": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "verifyEmail": false,
  "webAuthnPolicyExtraOrigins": [],
  "webAuthnPolicyPasswordlessExtraOrigins": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessRpEntityName": "Rasputin",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyRpEntityName": "Rasputin",
  "webAuthnPolicyUserVerificationRequirement": "required"
}
