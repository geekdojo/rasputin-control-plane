  {
    "alias": "rasputin-reset-no-codes",
    "requirement": "CONDITIONAL",
    "children": [
      {
        "provider": "conditional-sub-flow-executed",
        "requirement": "REQUIRED",
        "configAlias": "rasputin-reset-no-codes-not-executed",
        "config": {
          "check_result": "not-executed",
          "flow_to_check": "rasputin-reset-codes"
        }
      },
      {
        "provider": "deny-access-authenticator",
        "requirement": "REQUIRED",
        "configAlias": "rasputin-reset-no-codes-deny",
        "config": {
          "denyErrorMessage": "Recovery codes can't be used for this account. Sign in with a passkey, or ask an administrator to reset your password."
        }
      }
    ]
  },
