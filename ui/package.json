{
  "name": "rasputin-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "rm -rf .test-out && tsc -p tsconfig.test.json && node --test \".test-out/**/*.test.js\"",
    "identity-theme:styles": "rm -rf .test-out && tsc -p tsconfig.test.json && node .test-out/identity-theme/styles.js",
    "identity-theme:build": "node identity-theme/build.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "4.13.0",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
